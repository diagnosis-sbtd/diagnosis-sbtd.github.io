// Decision tree for phi3 on the retry trace, as in the paper's running-example figure.
digraph DiagnosisTree {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    margin=0.18,
    pad=0.18,
    nodesep=0.7,
    ranksep=0.6,
    splines=line,
    outputorder=edgesfirst,
    ordering=out
  ];

  node [
    fontname="Helvetica, Arial, sans-serif",
    fontsize=17,
    fontcolor="#1d2321",
    shape=ellipse,
    style="filled",
    fillcolor="#ffffff",
    color="#1d2321",
    penwidth=1.4
  ];

  edge [
    fontname="Helvetica, Arial, sans-serif",
    fontsize=14,
    fontcolor="#5b6561",
    color="#8a928e",
    penwidth=1.3,
    arrowhead=none
  ];

  root    [label="φ3(∞)"];
  conn    [label="φ3(and)"];
  inf_and [label="φ3(∞)"];
  ypos    [label="φ3(3.5)"];
  zero    [label="φ3(0)"];
  inf_or  [label="φ3(∞)"];

  node [shape=box, margin="0.14,0.06", fontsize=15];
  t1396 [label="True (1396)", color="#1f4e79", fontcolor="#1f4e79"];
  t160  [label="True (160)",  color="#1f4e79", fontcolor="#1f4e79"];
  t64   [label="True (64)",   color="#1f4e79", fontcolor="#1f4e79"];
  f168  [label="False (168)", color="#a8442f", fontcolor="#a8442f"];
  f881  [label="False (881/1)", color="#a8442f", fontcolor="#a8442f"];
  t7    [label="True (7)",    color="#1f4e79", fontcolor="#1f4e79"];
  f18   [label="False (18)",  color="#a8442f", fontcolor="#a8442f"];

  root -> t1396 [label="          ≤ 4.6998 s"];
  root -> conn  [label="  > 4.6998 s  "];

  conn -> inf_and [label="  and  "];
  conn -> zero    [label="  or  "];

  inf_and -> t160 [label="          ≤ 5.2003 s"];
  inf_and -> ypos [label="  > 5.2003 s  "];

  ypos -> t64  [label="          ≤ 2.8006 m"];
  ypos -> f168 [label="  > 2.8006 m  "];

  zero -> f881   [label="          ≤ 4.9250 s"];
  zero -> inf_or [label="  > 4.9250 s  "];

  inf_or -> t7  [label="          ≤ 5.0639 s"];
  inf_or -> f18 [label="  > 5.0639 s  "];
}
